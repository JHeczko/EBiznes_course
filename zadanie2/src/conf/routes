# assets play route
GET /assets/*file controllers.Assets.versioned(path="/public", file: Asset)

# ============ PRODUCT API ============
GET     /products/all             controllers.ProductController.getAll
# Przykład: POST /products/create?name=Monitor&price=599.99&catId=1
POST    /products/create          controllers.ProductController.create(name: String, price: Double, catId: Int)
GET     /products/read            controllers.ProductController.read(id: Int)
# Przykład: PATCH /products/update?id=1&price=2500.0
PATCH   /products/update          controllers.ProductController.update(id: Int, name: Option[String], price: Option[Double], catId: Option[Int])
DELETE  /products/delete          controllers.ProductController.delete(id: Int)

# ============ CATEGORY API ============
GET     /categories/all           controllers.CategoryController.getAll
POST    /categories/create        controllers.CategoryController.create(name: String)
GET     /categories/read          controllers.CategoryController.read(id: Int)
PATCH   /categories/update        controllers.CategoryController.update(id: Int, name: Option[String])
DELETE  /categories/delete        controllers.CategoryController.delete(id: Int)

# ============ CART API ============
GET     /cart/all                 controllers.CartController.all
POST    /cart/create              controllers.CartController.create(productId: Int, quantity: Int)
GET     /cart/read                controllers.CartController.read(productId: Int)
PATCH   /cart/update              controllers.CartController.update(productId: Int, quantity: Int)
DELETE  /cart/delete              controllers.CartController.delete(productId: Int)